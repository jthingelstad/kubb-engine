 "play": [
  {
   "id": "inkast-technique",
   "what": "How a kubb is thrown in",
   "beginner": "An underhand toss with no spin. It tumbles, lands flat or end over end, bounces and rolls. No group.",
   "club": "A drill: nose down, landing near a chosen spot. Control is loose, so the group is loose.",
   "pro": "A drill with the nose down and spin held to the touch. Lands on its spot and stops or rolls into the kubb before it.",
   "basis": "owner"
  },
  {
   "id": "inkast-spot",
   "what": "Where the kubbs go",
   "beginner": "Somewhere past the centre line, often the middle of the half.",
   "club": "The corner by the centre line and a sideline, a safe step inside both lines.",
   "pro": "The same corner, pushed to the lines: a first throw that goes out is thrown again, so the first throw can take the risk.",
   "basis": "owner, measured"
  },
  {
   "id": "group-shape",
   "what": "The shape built",
   "beginner": "None.",
   "club": "Two or three in a line along the throw; four or more as a cluster.",
   "pro": "The same, tight: a group one baton can take.",
   "basis": "owner, coach"
  },
  {
   "id": "wood-on-wood",
   "what": "A thrown kubb landing on one already down",
   "beginner": "Happens; not thought about.",
   "club": "Avoided: land short and roll in, or beside the group.",
   "pro": "Never risked without a reason.",
   "basis": "coach"
  },
  {
   "id": "cut",
   "what": "Entering the group from the side with wrist spin, so the kubb hops across into it",
   "beginner": "No.",
   "club": "Rarely.",
   "pro": "A standard shot.",
   "basis": "coach"
  },
  {
   "id": "replan",
   "what": "After a kubb lands away from the plan",
   "beginner": "Keeps tossing.",
   "club": "Keeps the plan until forced off it.",
   "pro": "Looks at what is down and what is in hand, then builds where one baton can take the most.",
   "basis": "coach"
  },
  {
   "id": "deep-kubbs",
   "what": "Throwing kubbs to 7 or 8 m when the team cannot clear them all",
   "beginner": "Does not know it; would gain the most from it.",
   "club": "The teams that know their limit do it: clear what the batons can, send the rest deep.",
   "pro": "Seldom needed: the field is cleared nine turns in ten.",
   "basis": "coach"
  },
  {
   "id": "rescue",
   "what": "Knocking a standing field kubb on a line out of play with a thrown kubb, to get it back",
   "beginner": "No.",
   "club": "Almost never.",
   "pro": "Known and rare: 3 in 5,270 kubbs thrown in.",
   "basis": "coach, measured"
  },
  {
   "id": "raising",
   "what": "Which end the defender stands a kubb on",
   "beginner": "Either.",
   "club": "Apart from its neighbours.",
   "pro": "Apart, every time: 'their least advantageous location'.",
   "basis": "owner, coach"
  },
  {
   "id": "punishment",
   "what": "Where the defender stands a punishment kubb",
   "beginner": "Far away.",
   "club": "Deep, far from the group, often on the baseline or a sideline.",
   "pro": "Deep and far from the group, on the side away from the opponent's corner.",
   "basis": "coach"
  },
  {
   "id": "field-batons",
   "what": "Batons at field kubbs",
   "beginner": "One kubb at a time, nearest first.",
   "club": "The group first; the best throwers go after the inkastare's group.",
   "pro": "The first baton is thrown to take the group: two or more kubbs seven times in ten from a group of four or five.",
   "basis": "measured, coach"
  },
  {
   "id": "king",
   "what": "The king",
   "beginner": "Thrown at as soon as it is allowed.",
   "club": "Thrown at when the base kubbs are down.",
   "pro": "A team that reaches the king takes it: about one king shot a game.",
   "basis": "measured"
  }
 ],
